 "poems": [
  {
   "seq": "1",
   "text": "きのふみし雪ひきかへてふる雨のみのしろ衣はるは來にけり",
   "kana": "",
   "speaker": "神主從四位下津守宿禰國冬",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ねのひする野への小松の春雨に置しら露は千代のかすかも",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "三輪の山霞にしのふ雨の音も人にしられぬ春のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "深山にはなけともいまた雪降て都は雨にうくひすのこゑ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春日野は春雨ふりぬあをによしならのあすかちわかな摘てん",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "淋しさをふる春雨に讓をきてあとなき庭の雪そきえ行",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "白妙の梅のたちえの雨のよにおもひのほかの月をみるかな",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春雨にまたぬきとむる靑柳の露はかりたにふかぬ風かな",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "萠出る野邊のさわらひみるほとに我も物うき春さめの空",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "わか草の露ふみみたす春駒はあめのうちにもあとや尋む",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "かり衣ぬれてよふかき春兩に野へのきゝすも露になくなり",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "春雨やはや晴かたに成ぬらんをのつからたつ雲雀なく也",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "いつはりのたか言の葉そ春雨にかきくもりたる鴈の玉つさ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "山里のたちよる軒の春雨にぬれたにもせて老をみるかな",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "水こみていまこそ種をまきもくのあなしの山田春雨そふる",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "雲雀鳴小野の芝生のつほすみれ此春雨に咲にけらしも",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あら小田も降春雨に水こめてよもきかくれにかはつ鳴なり",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "降雨によその尾上は見えわかて空にのそめるやまふきの花",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "雨に咲たこの浦藤をきあまる露のそこさへさそにほふらん",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "をのか入やよひの雲の春雨にさそうくひすのなみたそふらん",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "藤の花ぬれ〓〓折し衣手をたちかふるけさも雨はふりつゝ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "めつらしき卯月の雨のくもりかなのこれる花の嶺のしら雲",
   "kana": "",
   "speaker": "祈雨百首夏",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "降雨やたまるひろ葉にあまるらんならのしけみの雫おつなり",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "柏木のもとつはなしみもる雨にぬるともけふや榊とるらむ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "玉川の卯花くたしふる雨に波そたちそふなみそきえ行",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "此水にさなへとれとや時鳥田のもの雨に啼わたるらん",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "をのつから袖のみしふをすゝくかな早苗は雨にとるへかり鳬",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "袖ならぬ軒のあやめも置露に玉をはなれぬさみたれの頃",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "たち花の梢の花を舟なからたおる小島のさみたれの頃",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "五月雨にまさるみかさの高島やかちのゝ草もなみやこすらん",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "さみたれにもしほはやかし芦の屋の浦の煙やよはの蚊遣火",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "五月雨の水かさの底のかまくちて空にむなしくゆく螢かな",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "蜩のなく山かけをいとゝ又暮ぬとみせて雨はふりつゝ",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "むすふ手の雫をそへて涼しきは山井の水のむら雨の空",
   "kana": "",
   "speaker": "",
   "page": 477,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "もろ人の出る河瀨にふる雨のあかすや浪のゆふかさぬらん",
   "kana": "",
   "speaker": "祈雨百首秋",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "あさち原秋くるけさのかきくもり雨こそ露のはしめ成けれ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "中〓〓に雨にさはらてかよふらし淺瀨もしらぬあまの川ふね",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "虫の音を雨にまちぬる夕暮はみたるゝあともまたもとの露",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "袖にのみふるかとそおもふ只ならぬ荻ふく風の夕くれのあめ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "萩かはな下葉色つく秋の雨は音をきくにもねられさりけん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "降雨に波こす澤の女郎花あまるなみたにたれをこふらん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "ふる雨もまた一村そそゝくなるまた野とならぬ庭のすゝきに",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "ひとかたに風にはなひく苅萱のとにかくになる雨のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "名にしおへはかれ行色は染てけり寒き時雨のまつ虫のこゑ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "鴈鳴てしくれふる也いとゝ又山のこのはや色かはるらむ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "かりにとふ道やさはらん鶉啼深草の野の秋のむらさめ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "をのかふす草ねに水やこえぬらん澤邊のしきの雨に立ぬる",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "いか計萩の下露ふかゝらん鹿なく暮のあきのむらさめ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "穗なみにやたのきのさいの上るらむ稻葉に餘る雨のみかさに",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "かた岡の霧よりつゝく村雨やけさくる鴈のなみた成らん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "心ありてもみちを染る時雨こそ月のあたりにくもらさりけれ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "衣うつよさむの雨に山姬のにしきの袖もおりかさぬらし",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "降雨にきくの下水まさるえくむにつきせぬよはひしれとや",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "色そむる時雨とみすは立田山もみちへたつる雲やうからん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "冬をさそいかに分てか浮雲の秋にかゝりてまつしくるらん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "都よりひらの高根の浮雲をみれは時雨るゝ冬は來にけり",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "木の葉ちり時雨降よそせめてうき寢よと諫めし人もなき身に",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "枯もせす色をもかへぬ榊葉の霜にかされて降しくれ哉",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "荻の葉の末こす風の吹さえてはや冬かれにをける霜かな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "雪けなる時雨吹しほる風にまつ下をれぬへくなひく松哉",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "さはた河氷る朝けに行人の猶袖ぬれて降しくれかな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "千鳥には馴てれぬへきすまの浦時雨やつらきよはの關守",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "龍田用いかに時雨をはらひてか鴨の靑羽の紅葉さるなん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "網代木の浪ふきたつる山風にすくる時雨の行衞しらすも",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "そめもあへす外山の正木風さえて霰ましりに降時雨かな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "埋もるゝ宿の時雨の庭たつみしたこそとけね雪のうは水",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "雪をこそうち拂ひても狩衣とたちの雨そせんかたもなき",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "冬さむくしくるゝまゝに炭かまの煙をそへてくもる空かな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "降雨のもりてきえぬと思ふまて影かすかなるねやのうつみ火",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "ふり〓〓て空にや雪のつきぬらん雨に成ぬる年の暮かな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "わか袖に冬の時雨はしりそめぬいつ秋風にあはんとすらん",
   "kana": "",
   "speaker": "祈雨百首戀",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "人しれぬ戀のくもりを便りにて泪の雨のふらぬ日そなき",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "哀しれ長きよつらき窓の雨にうちまかせたる思ひならぬを",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "いつ迄かふるとも雨を契りけんなきたる朝といとはるゝ身に",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "戀衣もとの袖こそほさゝらめみたらし川に雨はふりきぬ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "これ程のか〓とはなきにこぬ人をこよひの雨になにか待らん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "降雨にとふこそいとゝなさけなれ月をたにみす歎かまし身を",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "まつ宵にいひしかはやと分れちの雨にも人のさはらさるらん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "山の端にしけき時雨もある物をめくりあはてもふる月日かな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "我うらみ末もとをらぬ涙かな過る時雨のあめもある世に",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "明はてぬ尾上の雲の村しくれはなれもやらて降よなりけり",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "たけくまの雨にたちよる松笠もおなし雫の宮城のゝ露",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "嵐ふく露も葉わけにこほれけり離の竹のいさゝむらさめ",
   "kana": "",
   "speaker": "爲兼卿鹿百首",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "近江路のうねのゝたつの聲はして明ぬや雨のくもるなるらむ",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "〓捨山あらそふ槇の村時雨思はぬこけもさこそ染らめ",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "降雨ももらぬこすゑのしけみかなかさとり山に笠とらぬまて",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "もとの瀨はなをこそみゆれあすか川淺き淵ある五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "あさちふの小野の夕立空にさへしのをたれてもふれる雨哉",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "〓みかた行へきいそのしほかれに猶關をもる五月雨のなみ",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "待人のさそさはるらむ雨のよに哀とはおもふ宇治の橋ひめ",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "五月雨のもらぬ蘆やのかひもなしやかぬに消る海士の藻鹽火",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "富士の根そ雲にかくるゝ大井川雨にやすらふあたら日數に",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "いかはかり草の庵の雨のよにしきみかはらの露けかるらん",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "まはらなる庵をもしらす秋の田の雨をうれしと思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "過やすきね覺の雲のはては又をのれ夢にもなる時雨哉",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "かしこしな時雨降をけるならのはのひろく集めし敷島の道",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "言の葉の雲のうへまてきこえよと身はしもなから雨いのる哉",
